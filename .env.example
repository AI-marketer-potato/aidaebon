# ===== 릴스 대본 메이커 환경변수 =====

# OpenAI API 키 (없으면 자동으로 '데모 모드'로 동작)
OPENAI_API_KEY=

# 사용할 모델 (선택, 기본값: gpt-4o)
OPENAI_MODEL=gpt-4o

# 관리자(/admin) 비밀번호 (미설정 시 개발용 기본값 'aidaebon')
ADMIN_PASSWORD=

# Vercel Blob 토큰 (레퍼런스 영구 저장용)
# - 비어 있으면: 로컬 data/references.json 파일에 저장 (npm run dev 그대로 동작)
# - 값이 있으면: Vercel Blob(클라우드)에 저장 → 배포 환경에서도 어드민 추가분 영구 보존
# 배포 시엔 Vercel 대시보드에서 Blob 저장소를 연결하면 이 변수가 자동으로 주입됩니다.
# (로컬에서 Blob로 테스트하려면 `vercel env pull .env.local` 로 받아오세요.)
BLOB_READ_WRITE_TOKEN=
